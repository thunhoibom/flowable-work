WORKFLOW_DB_URL=jdbc:postgresql://localhost:5432/workflow_agent
WORKFLOW_DB_USERNAME=workflow_agent
WORKFLOW_DB_PASSWORD=workflow_agent

# Required by workflow security in local development.
# Generate with:
#   powershell -NoProfile -Command "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))"
WORKFLOW_MASTER_KEY_BASE64=
WORKFLOW_LOCAL_DEV_SECRET=change-me-local-dev-secret

# Allow deployments that contain a sandboxed JavaScript script task.
WORKFLOW_SCRIPT_TASK_ENABLED=false

# Largest BPMN document accepted for a draft or a published version, in bytes.
WORKFLOW_DEFINITION_MAX_BPMN_BYTES=2097152

# How many subprocesses may be nested inside one another.
WORKFLOW_SUBPROCESS_MAX_NESTING_DEPTH=3

# Allow publishing processes that call other published processes (call activity).
WORKFLOW_SUBPROCESS_CALL_ACTIVITY_ENABLED=false
# Longest chain of processes calling one another, the root included.
WORKFLOW_SUBPROCESS_MAX_CALL_DEPTH=5
WORKFLOW_SUBPROCESS_MAX_IO_PARAMETERS=64
