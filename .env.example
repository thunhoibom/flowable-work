# Local evaluation only. Replace every secret before using a shared environment.
POSTGRES_PASSWORD=workflow_agent
WORKFLOW_MASTER_KEY_BASE64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# Sign-in: Keycloak SSO only (realm "rsa"). Roles come from the token's eim_roles claim,
# assigned in EIM (WF_PLATFORM_ADMIN, WF_ADMIN, WF_OPERATOR, WF_VIEWER). Menu: EIM sitemap.
WORKFLOW_KEYCLOAK_SERVER_URL=https://uat-auth-sso.vetc.com.vn
WORKFLOW_KEYCLOAK_REALM=rsa
WORKFLOW_KEYCLOAK_CLIENT_ID=VETC.WORKFLOW
WORKFLOW_KEYCLOAK_CLIENT_SECRET=
WORKFLOW_KEYCLOAK_ALLOWED_CLIENT_IDS=VETC.WORKFLOW
WORKFLOW_EIM_APP_CODE=VETC.WORKFLOW
